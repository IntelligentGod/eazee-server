rules_version = '2';

// Only the Eazee server writes this database, through the Admin SDK (which
// bypasses these rules). Clients may read their own records; admins (custom
// claim `admin: true`, set by src/scripts/setAdmin.ts) may read everything.
// Every client write is denied, so no client can grant itself Pro or admin.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;

      match /transactions/{transactionId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;
      }
    }

    // Admin purchase lists query every user's transactions at once.
    match /{path=**}/transactions/{transactionId} {
      allow read: if isAdmin();
    }

    match /aiUsage/{uid}/days/{day} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    match /config/subscription {
      allow read: if signedIn();
      allow write: if false;
    }

    match /revenueDaily/{dayId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /appleNotifications/{notificationId} {
      allow read, write: if false;
    }

    // Anything not listed above is denied.
  }
}
