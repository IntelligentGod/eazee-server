rules_version = '2';

// Only the Eazee server writes this database, through the Admin SDK (which
// bypasses these rules). Clients may read their own records; staff (custom
// claim `role` of `admin` or `superAdmin`, set only by the server) may read the
// admin data; role changes and the role config are for the super admin only.
// Every client write is denied, so no client can grant itself Pro or a role.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.role in ['admin', 'superAdmin'];
    }
    function isSuperAdmin() {
      return signedIn() && request.auth.token.role == 'superAdmin';
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;

      match /transactions/{transactionId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;
      }
    }

    // Admin purchase lists query every user's transactions at once.
    match /{path=**}/transactions/{transactionId} {
      allow read: if isAdmin();
    }

    match /aiUsage/{uid}/days/{day} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    match /config/subscription {
      allow read: if signedIn();
      allow write: if false;
    }

    match /revenueDaily/{dayId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /roleChanges/{changeId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /config/roles {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /appleNotifications/{notificationId} {
      allow read, write: if false;
    }

    // Anything not listed above is denied.
  }
}
